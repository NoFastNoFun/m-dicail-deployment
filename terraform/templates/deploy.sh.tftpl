#!/usr/bin/env bash
set -euo pipefail

DEPLOY_PATH="${deploy_path}"
DOMAIN="${domain}"
ACME_EMAIL="${acme_email}"
BACKEND_REPO_URL="${backend_repo_url}"
BACKEND_REF="${backend_ref}"
MANAGE_FIREWALL="${manage_firewall}"
SSH_PORT="${ssh_port}"
COMPOSE_FILE="$${DEPLOY_PATH}/docker-compose.prod.yml"
FIREWALL_SCRIPT="$${DEPLOY_PATH}/.generated/configure-host-firewall.sh"

export DEBIAN_FRONTEND=noninteractive
export GIT_TERMINAL_PROMPT=0

TOKEN_FILE="$${DEPLOY_PATH}/.generated/backend-git-token"

# Never use SSH for GitHub on the VPS (avoids host-key prompts / deploy keys).
unset GIT_SSH_COMMAND || true

log() {
  echo "[m-dicail-deploy] $*"
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1
}

read_backend_token() {
  if [[ -n "$${BACKEND_GIT_TOKEN:-}" ]]; then
    printf '%s' "$${BACKEND_GIT_TOKEN}"
    return
  fi
  if [[ -f "$${TOKEN_FILE}" ]]; then
    tr -d '\r\n' < "$${TOKEN_FILE}"
  fi
}

# Force HTTPS even if tfvars / an old clone uses git@github.com:...
https_github_url() {
  local url="$1"
  case "$${url}" in
    git@github.com:*)
      printf 'https://github.com/%s' "$${url#git@github.com:}"
      ;;
    ssh://git@github.com/*)
      printf 'https://github.com/%s' "$${url#ssh://git@github.com/}"
      ;;
    https://github.com/*|http://github.com/*)
      printf '%s' "$${url}"
      ;;
    *)
      printf '%s' "$${url}"
      ;;
  esac
}

# https://github.com/org/repo.git + PAT -> https://x-access-token:PAT@github.com/org/repo.git
# This is the auth form GitHub documents for non-interactive HTTPS (no Username prompt).
github_authed_url() {
  local clean token hostpath
  clean="$(https_github_url "$1")"
  token="$(read_backend_token)"
  if [[ -z "$${token}" ]]; then
    log "ERROR: empty GitHub PAT. Set backend_git_token in terraform.tfvars, then terraform apply."
    log "ERROR: expected token file: $${TOKEN_FILE}"
    exit 1
  fi
  hostpath="$${clean#https://}"
  hostpath="$${hostpath#http://}"
  # Drop any pre-existing userinfo
  if [[ "$${hostpath}" == *@* ]]; then
    hostpath="$${hostpath#*@}"
  fi
  printf 'https://x-access-token:%s@%s' "$${token}" "$${hostpath}"
}

git_fetch_or_clone_cleanup_remote() {
  local dir="$1"
  local clean_url="$2"
  git -C "$${dir}" remote set-url origin "$${clean_url}"
}

install_docker() {
  if require_cmd docker && docker compose version >/dev/null 2>&1; then
    log "Docker and Compose already installed"
    return
  fi

  log "Installing Docker Engine + Compose plugin"
  if require_cmd apt-get; then
    apt-get update -y
    apt-get install -y ca-certificates curl
  elif require_cmd dnf; then
    dnf install -y curl
  fi

  curl -fsSL https://get.docker.com | sh
  systemctl enable --now docker || true

  if ! docker compose version >/dev/null 2>&1; then
    log "Docker Compose plugin missing after install"
    exit 1
  fi
}

install_certbot() {
  if require_cmd certbot; then
    log "Certbot already installed"
    return
  fi

  log "Installing Certbot"
  if require_cmd apt-get; then
    apt-get update -y
    apt-get install -y certbot
  elif require_cmd dnf; then
    dnf install -y certbot
  else
    log "Install certbot manually, then re-run terraform apply"
    exit 1
  fi
}

configure_firewall() {
  if [[ ! -f "$${FIREWALL_SCRIPT}" ]]; then
    log "ERROR: missing firewall script at $${FIREWALL_SCRIPT}"
    exit 1
  fi
  chmod 755 "$${FIREWALL_SCRIPT}"
  env MANAGE_FIREWALL="$${MANAGE_FIREWALL}" SSH_PORT="$${SSH_PORT}" \
    bash "$${FIREWALL_SCRIPT}"
}

# Stop leftover stacks that may still publish 5432/8000 (e.g. backend docker-compose.yml).
stop_insecure_published_stacks() {
  if ! require_cmd docker; then
    return 0
  fi
  local id name ports
  while IFS=$'\t' read -r id name ports; do
    [[ -n "$${id}" ]] || continue
    if echo "$${ports}" | grep -Eq '0\.0\.0\.0:(5432|8000|8001)->|:::(5432|8000|8001)->'; then
      log "Stopping container with public app/db ports: $${name} ($${ports})"
      docker stop "$${id}" >/dev/null 2>&1 || true
      docker rm "$${id}" >/dev/null 2>&1 || true
    fi
  done < <(docker ps --format '{{.ID}}\t{{.Names}}\t{{.Ports}}' 2>/dev/null || true)
}

sync_backend() {
  local backend_dir="$${DEPLOY_PATH}/backend"
  local clean_url auth_url
  mkdir -p "$${DEPLOY_PATH}"

  clean_url="$(https_github_url "$${BACKEND_REPO_URL}")"
  BACKEND_REPO_URL="$${clean_url}"
  auth_url="$(github_authed_url "$${clean_url}")"
  log "Backend git over HTTPS + PAT (x-access-token): $${BACKEND_REPO_URL}"

  if [[ -d "$${backend_dir}/.git" ]]; then
    log "Updating backend ($${BACKEND_REF})"
    git -C "$${backend_dir}" remote set-url origin "$${auth_url}"
    git -C "$${backend_dir}" -c credential.helper= -c core.askPass= fetch --all --tags --prune
    git_fetch_or_clone_cleanup_remote "$${backend_dir}" "$${clean_url}"
    if git -C "$${backend_dir}" rev-parse "refs/tags/$${BACKEND_REF}" >/dev/null 2>&1; then
      log "Checkout tag $${BACKEND_REF} (detached HEAD)"
      git -C "$${backend_dir}" checkout --detach "refs/tags/$${BACKEND_REF}"
      git -C "$${backend_dir}" reset --hard "refs/tags/$${BACKEND_REF}"
    else
      git -C "$${backend_dir}" checkout "$${BACKEND_REF}"
      git -C "$${backend_dir}" remote set-url origin "$${auth_url}"
      git -C "$${backend_dir}" -c credential.helper= -c core.askPass= pull --ff-only origin "$${BACKEND_REF}" || \
        git -C "$${backend_dir}" reset --hard "$${BACKEND_REF}"
      git_fetch_or_clone_cleanup_remote "$${backend_dir}" "$${clean_url}"
    fi
  else
    log "Cloning backend from $${BACKEND_REPO_URL}"
    rm -rf "$${backend_dir}"
    if ! require_cmd git; then
      if require_cmd apt-get; then
        apt-get update -y && apt-get install -y git
      elif require_cmd dnf; then
        dnf install -y git
      fi
    fi
    if ! git -c credential.helper= -c core.askPass= clone --branch "$${BACKEND_REF}" --depth 1 "$${auth_url}" "$${backend_dir}"; then
      git -c credential.helper= -c core.askPass= clone "$${auth_url}" "$${backend_dir}"
      git -C "$${backend_dir}" checkout "$${BACKEND_REF}"
    fi
    git_fetch_or_clone_cleanup_remote "$${backend_dir}" "$${clean_url}"
  fi
}

obtain_certificate() {
  mkdir -p /var/www/certbot /etc/letsencrypt

  if [[ -f "/etc/letsencrypt/live/$${DOMAIN}/fullchain.pem" ]]; then
    log "TLS certificate already present for $${DOMAIN}"
    return
  fi

  log "Obtaining Let's Encrypt certificate for $${DOMAIN} (standalone)"
  if [[ -f "$${COMPOSE_FILE}" ]]; then
    (cd "$${DEPLOY_PATH}" && docker compose -f "$${COMPOSE_FILE}" stop nginx) || true
  fi

  # Free port 80 if something else is listening
  if require_cmd ss && ss -ltn | grep -q ':80 '; then
    log "Port 80 is in use; attempting to stop conflicting listeners for Certbot"
    systemctl stop nginx 2>/dev/null || true
    systemctl stop apache2 2>/dev/null || true
  fi

  certbot certonly \
    --standalone \
    --non-interactive \
    --agree-tos \
    --email "$${ACME_EMAIL}" \
    -d "$${DOMAIN}" \
    --keep-until-expiring
}

install_renewal_hook() {
  local renew_script="/usr/local/bin/m-dicail-certbot-renew"
  cat > "$${renew_script}" <<EOF
#!/usr/bin/env bash
set -euo pipefail
DEPLOY_PATH="$${DEPLOY_PATH}"
COMPOSE_FILE="$${COMPOSE_FILE}"
cd "$${DEPLOY_PATH}"
certbot renew --quiet \
  --pre-hook "docker compose -f $${COMPOSE_FILE} stop nginx" \
  --post-hook "docker compose -f $${COMPOSE_FILE} start nginx"
EOF
  chmod 755 "$${renew_script}"

  # Deploy hook also reloads nginx if certbot ran without our wrapper
  local hook_dir="/etc/letsencrypt/renewal-hooks/deploy"
  mkdir -p "$${hook_dir}"
  cat > "$${hook_dir}/m-dicail-reload-nginx.sh" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd "$${DEPLOY_PATH}"
docker compose -f "$${COMPOSE_FILE}" exec -T nginx nginx -s reload \
  || docker compose -f "$${COMPOSE_FILE}" restart nginx
EOF
  chmod 755 "$${hook_dir}/m-dicail-reload-nginx.sh"

  echo "0 3 * * * root $${renew_script}" > /etc/cron.d/m-dicail-certbot
  chmod 644 /etc/cron.d/m-dicail-certbot
  systemctl enable --now certbot.timer 2>/dev/null || true
}

start_stack() {
  log "Building and starting Docker Compose stack"
  cd "$${DEPLOY_PATH}"
  stop_insecure_published_stacks
  # Force nginx recreate so a stale container cannot keep an old bind-mount view.
  docker compose -f "$${COMPOSE_FILE}" up -d --build --remove-orphans --force-recreate
  # Re-apply DOCKER-USER after compose publishes 80/443.
  if [[ -x /usr/local/sbin/m-dicail-docker-user-fw ]]; then
    /usr/local/sbin/m-dicail-docker-user-fw || true
  fi
  ASSERT_ONLY=true bash "$${FIREWALL_SCRIPT}"
}

health_check() {
  local url="https://$${DOMAIN}/health"
  log "Waiting for $${url}"
  local i
  for i in $(seq 1 36); do
    if curl -fsS --max-time 5 "$${url}" | grep -q ok; then
      log "Health check passed"
      return 0
    fi
    sleep 5
  done
  log "Health check failed after retries"
  docker compose -f "$${COMPOSE_FILE}" ps || true
  docker compose -f "$${COMPOSE_FILE}" logs --tail=80 || true
  exit 1
}

main() {
  if [[ "$${EUID}" -ne 0 ]]; then
    log "This script expects root (or passwordless sudo as root). Re-run via sudo."
    exit 1
  fi

  install_docker
  install_certbot
  stop_insecure_published_stacks
  configure_firewall
  sync_backend
  obtain_certificate
  start_stack
  install_renewal_hook
  health_check
  log "Deploy complete"
}

main "$@"
