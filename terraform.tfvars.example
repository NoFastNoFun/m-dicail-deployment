# Copy to terraform/terraform.tfvars (gitignored) and fill in real values.
# Or skip local tfvars entirely: use GitHub Actions → "Terraform apply" / "Sync VPS environment"
# with secrets stored in the deployment repo Settings → Secrets and variables → Actions.
# Cloudflare DNS: A record medicail.nf2.tech -> ssh_host (see README).

ssh_host             = "203.0.113.10"
ssh_user             = "root"
ssh_port             = 22
ssh_private_key_path = "~/.ssh/id_ed25519"

domain     = "medicail.nf2.tech"
acme_email = "ops@example.com"

# Optional overrides
# deploy_path      = "/opt/m-dicail"
# backend_repo_url = "https://github.com/NoFastNoFun/m-dicail-backend.git"
# backend_ref      = "main"
# manage_firewall  = true

# Required for private backend repos (classic or fine-grained PAT with contents:read).
# Do not put this in the git remote URL; Terraform writes it to the VPS as mode 600.
backend_git_token = "ghp_or_github_pat_xxx"

secret_key        = "change-me-to-a-long-random-string"
postgres_user     = "medicail"
postgres_password = "change-me-strong-password"
postgres_db       = "medicail"

# Optional
ncbi_api_key           = ""
groq_api_key           = ""
ncbi_email             = "ops@example.com"
access_token_ttl       = "1h"
refresh_token_ttl_days = 7

# Outbound mail (Proton SMTP). Set smtp_user/smtp_pass via GitHub Secrets, not in git.
smtp_host  = "smtp.proton.me"
smtp_port  = 587
smtp_user  = ""
smtp_pass  = ""
smtp_from  = ""

# WebAuthn display name (RP ID and origin are derived from domain)
webauthn_rp_name = "Medicail"

# Optional Firebase Admin for FCM (API skips send when empty). Prefer GitHub Secrets.
# firebase_private_key must use literal \n escapes, not real newlines.
# firebase_project_id    = ""
# firebase_client_email  = ""
# firebase_private_key   = ""
