# Copy to terraform/terraform.tfvars (gitignored) and fill in real values.
# Cloudflare DNS: A record medicail.nf2.dev -> ssh_host (see README).

ssh_host             = "203.0.113.10"
ssh_user             = "root"
ssh_port             = 22
ssh_private_key_path = "~/.ssh/id_ed25519"

domain     = "medicail.nf2.dev"
acme_email = "ops@example.com"

# Optional overrides
# deploy_path      = "/opt/m-dicail"
# backend_repo_url = "https://github.com/NoFastNoFun/m-dicail-backend.git"
# backend_ref      = "main"
# manage_firewall  = true

# Required for private backend repos (classic or fine-grained PAT with contents:read).
# Do not put this in the git remote URL; Terraform writes it to the VPS as mode 600.
backend_git_token = "ghp_or_github_pat_xxx"

secret_key        = "change-me-to-a-long-random-string"
postgres_user     = "mdicail"
postgres_password = "change-me-strong-password"
postgres_db       = "mdicail"

# Optional
ncbi_api_key           = ""
access_token_ttl       = "1h"
refresh_token_ttl_days = 7
